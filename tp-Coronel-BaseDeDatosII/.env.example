# FoodStore — PostgreSQL 16 local
# Copiar a .env y completar si el proyecto requiere variables de entorno.
# Ejemplo para uso con Docker o scripts psql.

PGHOST=localhost
PGPORT=5432
PGDATABASE=foodstore_trabajo
PGUSER=postgres
PGPASSWORD=postgres

# Bases del protocolo
PGDATABASE_ORIGINAL=foodstore_original
PGDATABASE_TRABAJO=foodstore_trabajo

# Backups
BACKUP_DIR=db/backups
